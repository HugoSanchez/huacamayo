+# ---- Verso browser-routine domain guard (injected by runtime patch) ----
+#
+# When Verso runs a browser routine it writes a guard file into the Hermes
+# home ({"connection_id", "domains", "start_url"}). While that file exists,
+# every browser command is gated: navigations must target an allowed domain,
+# and any other action first verifies the CURRENT top-level page is still
+# on-domain (click-triggered redirects, popups, form submits land here too).
+# Off-domain pages are recovered by navigating back to the routine's start
+# URL. No guard file -> no restrictions (interactive chat is unaffected).
+
+_VERSO_GUARD_PROBE = threading.local()
+
+
+def _verso_guard_config() -> Optional[Dict[str, Any]]:
+    try:
+        guard_path = os.path.join(get_hermes_home(), "verso-browser-guard.json")
+        if not os.path.isfile(guard_path):
+            return None
+        with open(guard_path, "rt", encoding="utf-8") as fp:
+            cfg = json.load(fp)
+        domains = cfg.get("domains")
+        if not isinstance(domains, list) or not domains:
+            return None
+        return cfg
+    except Exception:
+        # A torn read mid-write would fail-closed and kill a healthy run;
+        # treat unreadable as absent. The orchestrator writes it atomically
+        # (tmp file + rename) per lease.
+        return None
 
 
+def _verso_domain_allowed(url: str, domains: List[str]) -> bool:
+    try:
+        from urllib.parse import urlparse
+
+        parsed = urlparse(url)
+    except Exception:
+        return False
+    if parsed.scheme in ("about", ""):
+        # Only an explicit blank target passes; empty/schemeless does not.
+        return url == "about:blank"
+    if parsed.scheme not in ("http", "https"):
+        return False
+    host = (parsed.hostname or "").lower()
+    if not host:
+        return False
+    for domain in domains:
+        d = str(domain).lower().lstrip(".")
+        if d and (host == d or host.endswith("." + d)):
+            return True
+    return False
+
+
+def _verso_domain_guard_check(
+    task_id: str, command: str, args: List[str]
+) -> Optional[Dict[str, Any]]:
+    """Return a blocked-result dict, or None when the command may proceed."""
+    if getattr(_VERSO_GUARD_PROBE, "active", False):
+        return None
+    cfg = _verso_guard_config()
+    if cfg is None:
+        return None
+    domains = [str(d) for d in cfg.get("domains", [])]
+
+    if command == "open":
+        target = (args[0] if args else "").strip()
+        if not target or not _verso_domain_allowed(target, domains):
+            return {
+                "success": False,
+                "error": (
+                    "Blocked by Verso: this routine may only use "
+                    + ", ".join(domains)
+                    + ". Refusing to open " + repr(target) + ". Stay on the "
+                    "connected site; if the task needs another site, stop "
+                    "and report."
+                ),
+            }
+        return None
+
+    if command in ("close", "back"):
+        return None
+
+    # Every other command acts on the current page: verify it is still
+    # on-domain (a click/redirect/popup may have led elsewhere). The probe
+    # fails CLOSED: if the page URL cannot be read, no action runs against
+    # a page we cannot vouch for.
+    _VERSO_GUARD_PROBE.active = True
+    try:
+        probe = _run_browser_command(
+            task_id, "eval", ["window.location.href"],
+            timeout=5, _engine_override="auto",
+        )
+        current_url = ""
+        if probe.get("success"):
+            current_url = (
+                str(probe.get("data", {}).get("result", ""))
+                .strip().strip('"').strip("'")
+            )
+        if not probe.get("success") or not current_url:
+            return {
+                "success": False,
+                "error": (
+                    "Blocked by Verso: could not verify the current page "
+                    "stayed on the connected site (URL probe failed). This "
+                    "can be transient - retry the action once; if it keeps "
+                    "failing, stop and report."
+                ),
+            }
+        if current_url == "about:blank":
+            return None  # fresh/blank target - nothing to protect yet
+        if _verso_domain_allowed(current_url, domains):
+            return None
+        start_url = str(cfg.get("start_url") or "")
+        if start_url:
+            _run_browser_command(task_id, "open", [start_url], timeout=15)
+        return {
+            "success": False,
+            "error": (
+                "Blocked by Verso: the page navigated off the connected site "
+                "(" + current_url + "). Navigated back to the routine's start "
+                "page. Re-check state with browser_snapshot before "
+                "continuing; if this keeps happening, stop and report."
+            ),
+        }
+    finally:
+        _VERSO_GUARD_PROBE.active = False
+
