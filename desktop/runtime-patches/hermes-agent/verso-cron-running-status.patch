+    @staticmethod
+    def _with_running_status(job: dict) -> dict:
+        """Attach the scheduler's live execution state to a cron API job."""
+        try:
+            from cron.scheduler import get_running_job_ids
+            return {**job, "running": job.get("id") in get_running_job_ids()}
+        except Exception:
+            # The normal job data remains useful if an optional scheduler
+            # provider cannot expose its live execution registry.
+            return {**job, "running": False}
+
