+def _expose_cdp_tool_enabled() -> bool:
+    """Return whether the raw-CDP tool is explicitly enabled.
+
+    Opt-in via ``browser.expose_cdp_tool: true``. A CDP override routes the
+    *typed* browser tools to a shared local browser; exposing raw protocol
+    access (``Runtime.evaluate``, cookie dumps, target control) to the model
+    is a separate, stronger grant than merely attaching.
+    """
+    try:
+        from hermes_cli.config import cfg_get, read_raw_config
+        from utils import is_truthy_value
+
+        cfg = read_raw_config()
+        return is_truthy_value(cfg_get(cfg, "browser", "expose_cdp_tool"), default=False)
+    except Exception as exc:
+        logger.debug("Could not read browser.expose_cdp_tool from config: %s", exc)
+        return False
+
