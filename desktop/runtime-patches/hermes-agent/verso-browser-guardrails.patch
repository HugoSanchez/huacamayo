+def _ensure_verso_browser_started() -> None:
+    """Ask the local Verso sidecar to launch its browser on first use.
+
+    ``BROWSER_CDP_URL`` remains stable while Chrome is stopped, so Hermes can
+    start without launching a visible browser. The supervisor sets the lazy
+    launch marker only for Verso-managed endpoints.
+    """
+    if not is_truthy_value(os.environ.get("VERSO_BROWSER_LAZY_LAUNCH"), default=False):
+        return
+    base_url = os.environ.get("VERSO_ORCHESTRATOR_BASE_URL", "").rstrip("/")
+    if not base_url.startswith(("http://127.0.0.1:", "http://localhost:")):
+        return
+    try:
+        headers = {}
+        token = os.environ.get("VERSO_SIDECAR_AUTH_SECRET", "").strip()
+        if token:
+            headers["x-verso-sidecar-token"] = token
+        response = requests.post(f"{base_url}/browser/ensure", headers=headers, timeout=20)
+        response.raise_for_status()
+    except Exception as exc:
+        logger.warning("Could not start the Verso agent browser: %s", exc)
+
